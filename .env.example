# ==============================================================================
# PeThar Enterprise Configuration Example
# Copy this file to .env and fill in your actual production/staging credentials.
# NEVER commit real passwords or secret keys to version control.
# ==============================================================================

# Supabase (Primary Source of Truth: Ledger, Auth, Row Level Security)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL Configuration (Direct connection / Pooling)
DATABASE_URL="postgres://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Object Storage (Tigris S3 / InstaCloud S3 for KYC Documents & Avatars)
AWS_ACCESS_KEY_ID="your-s3-access-key-id"
AWS_SECRET_ACCESS_KEY="your-s3-secret-access-key"
AWS_ENDPOINT_URL_S3="https://t3.storage.dev"
AWS_REGION="auto"
BUCKET_NAME="pethar-kyc-storage"

# Email / SMS Dispatch Service (Transactional OTPs)
GMAIL_SENDER="no-reply@pethar.co.uk"
GMAIL_APP_PASSWORD="your-app-specific-password"
OTP_SERVER_PORT="3001"

# Legacy / Secondary Datastores (Optional / Migration only)
# MONGODB_URL="mongodb://user:password@host:port/pethar?authSource=admin&tls=true"
# MYSQL_URL="mysql://user:password@host:3306/app"
