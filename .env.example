# ==============================================================================
# PeThar Enterprise Configuration Example
# Copy this file to .env and fill in your actual production/staging credentials.
# Official System Email (Transactional Sender): pethar.wallet@gmail.com
# Official Project Security & Support Contact: pethar-app@protonmail.com
# Hard Peg: 1.00 AKD = 1.00 USD (1.00 ₳ = $1.00)
# NEVER commit real passwords or secret keys to version control.
# ==============================================================================

# Supabase (Primary Source of Truth: Ledger, Auth, Row Level Security)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-side only (never expose to the mobile app). Required by the admin
# console's /api/admin signed-URL endpoint so operators can view KYC images.
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL Configuration (Direct connection / Transaction Pooler)
# Dual-Wallet Schema: users, akd_wallets, crypto_wallets, transactions
DATABASE_URL="postgres://postgres:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Object Storage (Tigris S3 / InstaCloud S3 for KYC Documents & Avatars)
AWS_ACCESS_KEY_ID="your-s3-access-key-id"
AWS_SECRET_ACCESS_KEY="your-s3-secret-access-key"
AWS_ENDPOINT_URL_S3="https://t3.storage.dev"
AWS_REGION="auto"
BUCKET_NAME="pethar-kyc-storage"

# Email / SMS Dispatch Service (Transactional OTPs — Official System Sender)
GMAIL_SENDER="pethar.wallet@gmail.com"
GMAIL_APP_PASSWORD="your-app-specific-password"
OTP_SERVER_PORT="3001"

# All OTPs are dispatched in production via Supabase Auth / official system email.
# No test accounts or hardcoded OTPs are permitted.
