    "@scure/base": "^1.1.9",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "supabase": "^2.120.0",
