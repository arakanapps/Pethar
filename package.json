{
  "name": "pethar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Péthar (ဖေ့သာ) — Native Mobile Financial Infrastructure (Android & iOS Flutter Engine)",
  "type": "module",
  "scripts": {
    "build": "cd pethar-wallet && npm run build",
    "dev": "cd pethar-wallet && npm run dev",
    "start": "cd pethar-wallet && npm run preview",
    "lint:ui": "cd pethar-wallet && npm run lint:ui",
    "test": "cd pethar-wallet && flutter test",
    "analyze": "cd pethar-wallet && flutter analyze",
    "android": "./apps/android/run.sh",
    "android:apk": "./apps/android/build-apk.sh",
    "ios": "./apps/ios/run.sh",
    "ios:xcode": "./apps/ios/open-xcode.sh",
    "flutter:web": "cd pethar-wallet && npm run flutter:web",
    "flutter:build:web": "cd pethar-wallet && npm run flutter:build:web",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "supabase:link": "supabase link --project-ref uklqksioruxvatwpvopm",
    "supabase:db:pull": "supabase db pull",
    "supabase:db:push": "supabase db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
